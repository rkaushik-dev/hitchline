{
  "name": "hitchline",
  "version": "0.1.0",
  "private": true,
  "description": "Adherence tracking for crews working rotational hitches",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.10.0",
    "@types/node": "22.5.5",
    "eslint": "9.10.0",
    "prettier": "3.3.3",
    "typescript": "5.6.2",
    "typescript-eslint": "8.6.0",
    "vitest": "2.1.1"
  }
}
