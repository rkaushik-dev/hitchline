{
  "name": "hitchline",
  "version": "0.1.0",
  "private": true,
  "description": "Adherence tracking for crews working rotational hitches",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/integration tests/invariants",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage tests/unit tests/integration tests/invariants",
    "start": "node dist/bin/serve.js",
    "dev": "tsx watch src/bin/serve.ts",
    "cli": "tsx src/bin/hitchline.ts",
    "test:perf": "vitest run tests/performance",
    "test:all": "vitest run",
    "docs": "tsx src/bin/hitchline.ts docs api --out docs/api.md"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/node": "22.13.1",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.19.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.23.0",
    "vitest": "3.0.5"
  },
  "dependencies": {
    "commander": "13.1.0",
    "fastify": "5.2.1",
    "zod": "3.24.1"
  },
  "bin": {
    "hitchline": "dist/bin/hitchline.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
